<!DOCTYPE html>
<html lang="lt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Planavimo sistema</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schedule/schedule.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ServiceTaskPlanningSystem.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/select2-overrides.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAuthPage = Context?.Request?.Path.StartsWithSegments("/Authentication") ?? false;
        var currentEmail = Context?.Request?.Cookies["stsps_email"] ?? string.Empty;
        var isLoggedIn = Context?.User?.Identity?.IsAuthenticated == true;
        var isPlanner = isLoggedIn && (Context?.User?.IsInRole("manager") ?? false);
        var currentName = Context?.User?.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value?.Trim() ?? string.Empty;
        var displayName = !string.IsNullOrWhiteSpace(currentName)
            ? currentName
            : (!string.IsNullOrWhiteSpace(currentEmail) ? currentEmail.Split("@")[0] : "Vartotojas");
        var initial = !string.IsNullOrWhiteSpace(displayName)
            ? displayName.Substring(0, 1).ToUpperInvariant()
            : "V";
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Schedule" asp-action="Index">Planavimo sistema</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="d-sm-none"><hr class="my-0" /></li>

                        @if (!isAuthPage && isLoggedIn)
                        {
                            <li class="d-sm-none nav-mobile-account-inline">
                                <span class="nav-mobile-label">Prisijungta kaip</span>
                                <span class="nav-mobile-identity">
                                    <span class="nav-mobile-role">@displayName</span>
                                    @if (!string.IsNullOrWhiteSpace(currentEmail))
                                    {
                                        <span class="nav-mobile-email-inline">@currentEmail</span>
                                    }
                                </span>
                            </li>
                            <li class="d-sm-none"><hr class="my-1" /></li>
                        }

                        <li class="nav-item text-center">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Schedule" asp-action="Index">Tvarkaraštis</a>
                        </li>

                        @if (!isAuthPage && isLoggedIn)
                        {
                            @if (isPlanner)
                            {
                                <li class="d-sm-none"><hr class="my-1" /></li>
                                <li class="d-sm-none">
                                    <button class="nav-link nav-history-trigger w-100 text-start" type="button" data-bs-toggle="offcanvas" data-bs-target="#scheduleHistoryPanel" aria-controls="scheduleHistoryPanel">
                                        <i class="bi bi-clock-history" aria-hidden="true"></i>
                                        <span>Istorija</span>
                                    </button>
                                </li>
                            }

                            <li class="d-sm-none"><hr class="my-1" /></li>
                            <li class="d-sm-none">
                                <a class="nav-link nav-mobile-logout" asp-controller="Authentication" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Atsijungti
                                </a>
                            </li>
                        }
                        else if (isAuthPage || !isLoggedIn)
                        {
                            <li class="d-sm-none"><hr class="my-1" /></li>
                            <li class="nav-item d-sm-none text-center">
                                <a class="nav-link text-dark" asp-controller="Authentication" asp-action="Index">Prisijungti</a>
                            </li>
                        }
                    </ul>

                    <div class="d-none d-sm-flex align-items-center gap-2">
                        @if (!isAuthPage && isLoggedIn)
                        {
                            @if (isPlanner)
                            {
                                <button class="btn nav-history-trigger nav-history-trigger-desktop" type="button" data-bs-toggle="offcanvas" data-bs-target="#scheduleHistoryPanel" aria-controls="scheduleHistoryPanel">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                    <span>Istorija</span>
                                </button>
                            }

                            <div class="dropdown">
                                <button class="btn p-0 border-0 bg-transparent nav-avatar-btn dropdown-toggle d-flex align-items-center"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Profilio meniu">
                                    <span class="nav-avatar d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white">
                                        @initial
                                    </span>
                                    <i class="bi bi-chevron-down nav-avatar-chevron" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm nav-account-menu">
                                    <li class="nav-account-header">
                                        <div class="small text-muted">Prisijungta kaip</div>
                                        <div class="fw-semibold">@displayName</div>
                                        @if (!string.IsNullOrWhiteSpace(currentEmail))
                                        {
                                            <div class="small text-muted">@currentEmail</div>
                                        }
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Authentication" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Atsijungti
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Authentication" asp-action="Index">Prisijungti</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        <div class="page-container">
            @RenderBody()
        </div>
    </main>

    <div id="scheduleToastHost"
         class="toast-container schedule-toast-host position-fixed top-0 end-0 p-3"
         aria-live="polite"
         aria-atomic="true"></div>

    @if (isPlanner)
    {
        <div class="offcanvas offcanvas-end schedule-history-panel" tabindex="-1" id="scheduleHistoryPanel" aria-labelledby="scheduleHistoryPanelLabel">
            <div class="offcanvas-header">
                <div>
                    <h5 class="offcanvas-title" id="scheduleHistoryPanelLabel">Veiksmų istorija</h5>
                    <div class="small text-muted">Naujausi veiksmai rodomi viršuje</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="UÅ¾daryti"></button>
            </div>
            <div class="offcanvas-body">
                <div id="scheduleHistoryLoading" class="small text-muted">Kraunama istorija...</div>
                <div id="scheduleHistoryEmpty" class="schedule-history-empty d-none">Istorijos įrašų vis dar nėra.</div>
                <div id="scheduleHistoryList" class="schedule-history-list"></div>
            </div>
        </div>
    }

    @await RenderSectionAsync("Overlays", required: false)

    <footer class="footer text-muted">
        <div class="container d-flex justify-content-center align-items-center">
            <span>&copy; 2026 - Planavimo sistema</span>
        </div>
    </footer>

    <script src="~/js/schedule/infra/timezone.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/schedule/ui/schedule.toast.js" asp-append-version="true"></script>
    <script src="~/js/schedule/history/schedule.history.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>