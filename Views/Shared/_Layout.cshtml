<!DOCTYPE html>
<html lang="lt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Planavimo sistema</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schedule/schedule.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ServiceTaskPlanningSystem.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAuthPage = Context?.Request?.Path.StartsWithSegments("/Authentication") ?? false;
        var currentRole = Context?.User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLowerInvariant() ?? string.Empty;
        var currentEmail = Context?.Request?.Cookies["stsps_email"] ?? string.Empty;
        var isLoggedIn = Context?.User?.Identity?.IsAuthenticated == true;
        var roleLabel = currentRole == "technician" ? "Technikas" : "Vadovas";
        var initial = !string.IsNullOrWhiteSpace(currentEmail)
            ? currentEmail.Trim().Substring(0, 1).ToUpperInvariant()
            : "A";
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Schedule" asp-action="Index">Planavimo sistema</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Schedule" asp-action="Index">Tvarkaraštis</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (!isAuthPage && isLoggedIn)
                        {

                            <div class="dropdown">
                                <button class="btn p-0 border-0 bg-transparent nav-avatar-btn dropdown-toggle d-flex align-items-center"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Profilio meniu">
                                    <span class="nav-avatar d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white">
                                        @initial
                                    </span>
                                    <i class="bi bi-chevron-down nav-avatar-chevron" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm nav-account-menu">
                                    <li class="nav-account-header">
                                        <div class="small text-muted">Prisijungta kaip</div>
                                        <div class="fw-semibold">@roleLabel</div>
                                        @if (!string.IsNullOrWhiteSpace(currentEmail))
                                        {
                                            <div class="small text-muted">@currentEmail</div>
                                        }
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="#">Profilis</a></li>
                                    <li><a class="dropdown-item" href="#">Nustatymai</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Authentication" asp-action="Logout">
                                            Atsijungti
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Authentication" asp-action="Index">Prisijungti</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="pb-3">
        <div class="page-container">
            @RenderBody()
        </div>
    </main>

    @await RenderSectionAsync("Overlays", required: false)

    <footer class="footer text-muted">
        <div class="container d-flex justify-content-center align-items-center">
            <span>&copy; 2025 - Planavimo sistema</span>
        </div>
    </footer>
    <script src="~/js/schedule/infra/timezone.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
