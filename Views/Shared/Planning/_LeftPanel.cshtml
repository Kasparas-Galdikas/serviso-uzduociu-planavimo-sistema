@model (bool IsManager, DateTime WeekStart)
<div class="left-panel">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <div>
            <div class="fw-bold">Navigacija</div>
            <div class="small text-muted">Rodiniai ir filtrai</div>
        </div>
        <button class="btn btn-outline-secondary btn-sm" id="leftToggle">Suskleisti</button>
    </div>

    <div class="panel-section">
        <div class="section-title">Rodinys</div>
        <div class="btn-group w-100">
            <button class="btn btn-outline-primary btn-sm active">Savaitė</button>
            <button class="btn btn-outline-secondary btn-sm">Diena</button>
            <button class="btn btn-outline-secondary btn-sm">Mėnuo</button>
        </div>
    </div>

    <div class="panel-section">
        <div class="section-title">Data</div>
        <input type="date" class="form-control form-control-sm" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
    </div>

    <div class="panel-section">
        <div class="section-title">Filtrai</div>
        <label class="form-label small mb-1">Technikas</label>
        <select class="form-select form-select-sm mb-2">
            <option>Visi</option>
            <option>Vilnius</option>
            <option>Kaunas</option>
            <option>Šiauliai</option>
        </select>
        <label class="form-label small mb-1">Lokacija</label>
        <select class="form-select form-select-sm mb-2">
            <option>Visos</option>
            <option>Vilnius</option>
            <option>Kaunas</option>
            <option>Šiauliai</option>
            <option>Klaipėda</option>
        </select>
        <label class="form-label small mb-1">Statusas / prioritetas</label>
        <select class="form-select form-select-sm">
            <option>Visi</option>
            <option>Aukštas</option>
            <option>Vidutinis</option>
            <option>Žemas</option>
        </select>
    </div>

    <div class="panel-section">
        <div class="section-title">Veiksmai</div>
        <div class="d-grid gap-2">
            <button class="btn btn-outline-secondary btn-sm">Greita užduotis</button>
            <button class="btn btn-outline-secondary btn-sm">Matyti konfliktus</button>
            @if (Model.IsManager)
            {
                <button class="btn btn-primary btn-sm">+ Pridėti užduotį</button>
            }
            else
            {
                <button class="btn btn-outline-secondary btn-sm" disabled title="Režimas: tik peržiūra">+ Pridėti užduotį</button>
            }
        </div>
    </div>
</div>
