<div class="form-layout">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Pavadinimas</label>
            <input class="form-control" placeholder="Užduoties pavadinimas" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Pradžia</label>
            <input type="time" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Pabaiga</label>
            <input type="time" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Lokacija</label>
            <input class="form-control" placeholder="Miesto/regiono pavadinimas" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Prioritetas</label>
            <select class="form-select">
                <option>Aukštas</option>
                <option>Vidutinis</option>
                <option>Žemas</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Statusas</label>
            <select class="form-select">
                <option>Planuojama</option>
                <option>Vykdoma</option>
                <option>Baigta</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label">Pastabos</label>
            <textarea class="form-control" rows="2" placeholder="Papildoma informacija"></textarea>
        </div>
        <div class="col-12">
            <div class="alert alert-info small mb-0">Mock forma – validacija ir ispejimai bus prideti veliau.</div>
        </div>
    </div>
</div>
