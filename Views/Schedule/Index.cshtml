@model ServiceTaskPlanningSystem.Models.Planning.SchedulePageViewModel
@{
    ViewData["Title"] = "Tvarkarastis";
    var issues = Model.Issues ?? new List<ServiceTaskPlanningSystem.Models.Planning.IssueItem>();
    var isWeekly = string.Equals(Model.ViewMode, "week", StringComparison.OrdinalIgnoreCase);
}

<div class="page-header d-flex align-items-center mb-2 @(Model.IsManager ? "edit-mode" : string.Empty)">
    <div>
        <h1 class="h4 mb-0">@((isWeekly ? "Savaites grafikas" : "Dienos grafikas"))</h1>
    </div>
    <div class="ms-auto d-flex align-items-center gap-2">
        <span class="badge bg-secondary">Role: @(Model.IsManager ? "Vadovas" : "Technikas")</span>
        @if (Model.CurrentPlanId.HasValue)
        {
            <span class="badge bg-light text-dark border">Planas #@Model.CurrentPlanId (@Model.CurrentPlanStatus)</span>
        }
        @if (Model.HasDraft)
        {
            <span class="badge bg-warning text-dark">Juodrastis aktyvus</span>
        }
        @if (Model.IsManager)
        {
            <span class="badge bg-primary-subtle text-dark">Redagavimo rezimas ijungtas (mock)</span>
        }
    </div>
</div>
<div class="console-banner alert alert-info d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-sliders2-vertical"></i>
        <div>
            <div class="fw-semibold">Filtrai perkelti i konsole</div>
            <div class="small mb-0 text-muted">Paspausk apatinio desinio kampo mygtuka, kad atidarytum valdymus.</div>
        </div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#filterConsoleModal">
        Atidaryti konsole
    </button>
</div>

@if (Model.IsPreviewMode)
{
    var currentDate = isWeekly ? Model.WeekStart : Model.SelectedDate;
    <div class="alert alert-warning d-flex align-items-center justify-content-between mb-3 shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-eye"></i>
            <div>
                <div class="fw-semibold mb-0">Planavimo rezimas (juodrastis)</div>
                <div class="small mb-0">Perziurite suplanuota laikotarpi pries patvirtindami.</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#createTaskModal">Grizti</button>
            <button type="button" class="btn btn-danger btn-sm" id="discardPlanBtn" data-redirect="@Url.Action("Index", "Schedule", new { view = Model.ViewMode, date = currentDate.ToString("yyyy-MM-dd") })">Atsaukti</button>
            <button type="button" class="btn btn-primary btn-sm" id="publishPlanBtn" data-redirect="@Url.Action("Index", "Schedule", new { view = Model.ViewMode, date = currentDate.ToString("yyyy-MM-dd") })">Patvirtinti</button>
        </div>
    </div>
}

<div id="scheduleTables"
     data-current-view="@Model.ViewMode"
     data-plan-status="@Model.CurrentPlanStatus"
     data-plan-id="@Model.CurrentPlanId">
    @if (isWeekly)
    {
        @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_WeeklyTable.cshtml", Model)
    }
    else
    {
        @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_DailyTable.cshtml", Model)
    }
</div>
@await Html.PartialAsync("~/Views/Schedule/Partials/Issues/_IssuesModal.cshtml", issues)
@await Html.PartialAsync("~/Views/Schedule/Partials/Filters/_FilterConsole.cshtml", Model)
@await Html.PartialAsync("~/Views/Schedule/Partials/ScheduleCreate/_CreateScheduleModal.cshtml", Model)
@await Html.PartialAsync("~/Views/Schedule/Partials/ScheduleCreate/_SummaryScheduleModal.cshtml", Model)
@await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_TaskDetailModal.cshtml")


@section Scripts {
    <script src="~/js/schedule-filters.js" asp-append-version="true"></script>
    <script>
        // scroll highlight for issues from modal
        document.querySelectorAll('.issue-scroll').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const targetId = btn.getAttribute('data-target');
                const el = document.getElementById(targetId);
                if (!el) return;
                const modal = document.getElementById('issuesModal');
                const bsModal = bootstrap.Modal.getInstance(modal);
                bsModal?.hide();
                setTimeout(() => {
                    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    el.classList.add('highlight');
                    setTimeout(() => el.classList.remove('highlight'), 1500);
                }, 200);
            });
        });

        const discardBtn = document.getElementById('discardPlanBtn');
        if (discardBtn) {
            discardBtn.addEventListener('click', async () => {
                const redirect = discardBtn.getAttribute('data-redirect') || '/Schedule';
                discardBtn.setAttribute('disabled', 'disabled');
                discardBtn.setAttribute('aria-busy', 'true');
                try {
                    const resp = await fetch('/Plans/discard', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!resp.ok) {
                        throw new Error('Nepavyko atsaukti juodrascio');
                    }
                    window.location.href = redirect;
                } catch (err) {
                    console.error(err);
                    alert('Nepavyko atsaukti juodrascio. Bandykite dar karta.');
                } finally {
                    discardBtn.removeAttribute('aria-busy');
                    discardBtn.removeAttribute('disabled');
                }
            });
        }

        const publishBtn = document.getElementById('publishPlanBtn');
        if (publishBtn) {
            publishBtn.addEventListener('click', async () => {
                const redirect = publishBtn.getAttribute('data-redirect') || '/Schedule';
                publishBtn.setAttribute('disabled', 'disabled');
                publishBtn.setAttribute('aria-busy', 'true');
                try {
                    const resp = await fetch('/Plans/publish', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!resp.ok) {
                        throw new Error('Nepavyko patvirtinti plano');
                    }
                    window.location.href = redirect;
                } catch (err) {
                    console.error(err);
                    alert('Nepavyko patvirtinti plano. Bandykite dar karta.');
                } finally {
                    publishBtn.removeAttribute('aria-busy');
                    publishBtn.removeAttribute('disabled');
                }
            });
        }
    </script>
}
