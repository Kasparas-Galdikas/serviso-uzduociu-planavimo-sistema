@model ServiceTaskPlanningSystem.Models.Planning.SchedulePageViewModel
<!-- Planavimo santraukos modalas -->
<div class="modal fade" id="planningSummaryModal" tabindex="-1" aria-labelledby="planningSummaryLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="planningSummaryLabel">Tvarkarascio generavimo santrauka</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <div class="vstack gap-4">
                    <section>
                        <p class="text-muted small mb-1">1. Planavimo laikotarpis</p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Pradzios data</label>
                                <input type="date" class="form-control" id="summaryStartDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" disabled />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Pabaigos data</label>
                                <input type="date" class="form-control" id="summaryEndDate" disabled />
                            </div>
                        </div>
                        <div class="form-text">Santrauka rodo pasirinkta laikotarpi.</div>
                    </section>

                    <section>
                        <p class="text-muted small mb-1">2. Planavimo strategija</p>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="summaryPlanningStrategy" id="summaryStrategyBalanced" checked disabled>
                                <label class="form-check-label" for="summaryStrategyBalanced">Subalansuota</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="summaryPlanningStrategy" id="summaryStrategyMinimize" disabled>
                                <label class="form-check-label" for="summaryStrategyMinimize">Minimizuoti perkrova</label>
                            </div>
                        </div>
                        <div class="form-text">Strategija fiksuota pagal pasirinkta konfiguracija.</div>
                    </section>

                    <section>
                        <p class="text-muted small mb-1">3. Ribojimai</p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Maks. val. technikui per diena</label>
                                <input type="number" class="form-control" id="summaryDailyMax" min="4" max="12" placeholder="Pvz.: 8" disabled />
                                <div class="form-text">Maksimalus darbo kruvis.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Maks. is eiles pamainu</label>
                                <input type="number" class="form-control" id="summaryMaxShifts" min="1" max="14" placeholder="Pvz.: 5" disabled />
                            </div>
                            <div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="summaryAllowOvertime" disabled>
                                    <label class="form-check-label" for="summaryAllowOvertime">Leisti virsvalandzius prireikus</label>
                                </div>

                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="summaryIncludeWeekends" disabled>
                                    <label class="form-check-label" for="summaryIncludeWeekends">Itraukti savaitgalius</label>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
            <div class="modal-footer border-0">
                <div class="d-flex w-100 align-items-center justify-content-between gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#createTaskModal">Grizti</button>
                    <button type="button" class="btn btn-primary" id="summaryConfirmBtn" data-base-url="@Url.Action("Index", "Schedule")">Patvirtinti generavima</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const createModal = document.getElementById('createTaskModal');
        const summaryModal = document.getElementById('planningSummaryModal');
        if (!createModal || !summaryModal) return;
        const today = new Date().toISOString().slice(0, 10);
        const tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString().slice(0, 10);

        const startInput = document.querySelector('#createStartDate');
        const endInput = document.querySelector('#createEndDate');
        if (startInput) {
            startInput.setAttribute('min', today);
            if (!startInput.value || startInput.value < today) {
                startInput.value = today;
            }
        }
        if (endInput && startInput) {
            const syncEndMin = () => {
                const sVal = startInput.value || today;
                const minEnd = sVal > today ? sVal : tomorrow;
                endInput.setAttribute('min', minEnd);
                if (endInput.value && endInput.value < minEnd) {
                    endInput.value = minEnd;
                }
            };
            syncEndMin();
            startInput.addEventListener('change', syncEndMin);
        }

        const copyValue = function (sourceId, targetId, isCheckbox, isSelect, isRadio) {
            const source = createModal.querySelector('#' + sourceId);
            const target = summaryModal.querySelector('#' + targetId);
            if (!source || !target) return;
            if (isCheckbox) {
                target.checked = source.checked;
            } else if (isRadio) {
                target.checked = source.checked;
            } else if (isSelect) {
                target.value = source.value;
            } else {
                target.value = source.value;
            }
        };

        summaryModal.addEventListener('show.bs.modal', function () {
            copyValue('createStartDate', 'summaryStartDate');
            copyValue('createEndDate', 'summaryEndDate');

            copyValue('strategyBalanced', 'summaryStrategyBalanced', false, false, true);
            copyValue('strategyMinimize', 'summaryStrategyMinimize', false, false, true);

            copyValue('createDailyMax', 'summaryDailyMax');
            copyValue('createMaxShifts', 'summaryMaxShifts');
            copyValue('createAllowOvertime', 'summaryAllowOvertime', true);
            copyValue('createIncludeWeekends', 'summaryIncludeWeekends', true);
        });

        const confirmBtn = summaryModal.querySelector('#summaryConfirmBtn');
        if (confirmBtn) {
            confirmBtn.addEventListener('click', async function () {
                const baseUrl = confirmBtn.getAttribute('data-base-url') || '/Schedule/Index';
                const startInput = createModal.querySelector('#createStartDate');
                const endInput = createModal.querySelector('#createEndDate');
                const startDate = startInput && startInput.value ? startInput.value : '';
                const endDate = endInput && endInput.value ? endInput.value : '';

                const setBusy = (state) => {
                    confirmBtn.disabled = state;
                    confirmBtn.setAttribute('aria-busy', state ? 'true' : 'false');
                };

                const toDate = (val) => val ? new Date(val + 'T00:00:00') : null;
                const sDate = toDate(startDate);
                const eDate = toDate(endDate);
                let weeks = 4;
                if (sDate && eDate && eDate >= sDate) {
                    const diffDays = Math.floor((eDate - sDate) / (1000 * 60 * 60 * 24)) + 1;
                    weeks = Math.max(1, Math.ceil(diffDays / 7));
                }

                setBusy(true);
                try {
                    const resp = await fetch('/Plans/draft', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            startDate: startDate || null,
                            endDate: endDate || null,
                            weeks
                        })
                    });
                    if (!resp.ok) {
                        throw new Error('Request failed');
                    }

                    const url = startDate
                        ? `${baseUrl}?view=week&date=${encodeURIComponent(startDate)}`
                        : `${baseUrl}?view=week`;

                    const bsSummary = bootstrap.Modal.getInstance(summaryModal) || new bootstrap.Modal(summaryModal);
                    const bsCreate = bootstrap.Modal.getInstance(createModal);
                    bsSummary.hide();
                    bsCreate && bsCreate.hide();
                    window.location.href = url;
                } catch (err) {
                    console.error('Nepavyko sukurti juodrascio', err);
                    alert('Nepavyko sukurti juodrascio. Bandykite dar karta.');
                    setBusy(false);
                }
            });
        }
    });
</script>
