@model ServiceTaskPlanningSystem.Models.Planning.SchedulePageViewModel
@{
    var today = DateTime.Today;
    var plannedEnd = Model.PlannedPeriodEnd == default ? today : Model.PlannedPeriodEnd.Date;
    var firstFreeDay = plannedEnd.AddDays(1);
    var startValue = firstFreeDay < today ? today : firstFreeDay;
    var startValueStr = startValue.ToString("yyyy-MM-dd");
    var minDateStr = startValueStr; // prevent selecting dates that are already planned
    var minEndStr = startValueStr;
}
<div class="modal fade" id="createTaskModal" tabindex="-1" aria-labelledby="createTaskLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="createTaskLabel">Tvarkarascio generavimo nustatymai</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <div class="vstack gap-4">
                    <section>
                        <p class="text-muted small mb-1">1. Planavimo laikotarpis</p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Pradzios data</label>
                                <input type="date" class="form-control" id="createStartDate" value="@startValueStr" min="@minDateStr" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Pabaigos data</label>
                                <input type="date" class="form-control" id="createEndDate" min="@minEndStr" />
                            </div>
                        </div>
                        <div class="form-text">Pasirinkite laikotarpi nuo pradzios iki pabaigos, kuriam generuoti plana.</div>
                    </section>

                    <section>
                        <p class="text-muted small mb-1">2. Planavimo strategija</p>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="planningStrategy" id="strategyBalanced" checked>
                                <label class="form-check-label" for="strategyBalanced">Subalansuota</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="planningStrategy" id="strategyMinimize">
                                <label class="form-check-label" for="strategyMinimize">Minimizuoti perkrova</label>
                            </div>
                        </div>
                        <div class="form-text">Pasirinkite, kaip balansuoti resursus - pakeicia rankini priskyrima.</div>
                    </section>

                    <section>
                        <p class="text-muted small mb-1">3. Ribojimai</p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Maks. val. technikui per diena</label>
                                <input type="number" class="form-control" id="createDailyMax" min="4" max="12" placeholder="Pvz.: 8" />
                                <div class="form-text">Maksimalus darbo kruvis</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Maks. is eiles pamainu</label>
                                <input type="number" class="form-control" id="createMaxShifts" min="1" max="14" placeholder="Pvz.: 5" />
                            </div>
                            <div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="createAllowOvertime">
                                    <label class="form-check-label" for="createAllowOvertime">Leisti virsvalandzius prireikus</label>
                                </div>

                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="createIncludeWeekends">
                                    <label class="form-check-label" for="createIncludeWeekends">Itraukti savaitgalius</label>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
            <div class="modal-footer border-0">
                <div class="d-flex w-100 align-items-center justify-content-between gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Atsaukti</button>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#planningSummaryModal">Toliau</button>
                </div>
            </div>
        </div>
    </div>
</div>
