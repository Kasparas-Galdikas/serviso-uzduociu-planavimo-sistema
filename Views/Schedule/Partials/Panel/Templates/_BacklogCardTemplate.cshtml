<template id="backlogCardTpl">
  <div class="backlog-card">
    <div class="backlog-card__row">
      <input type="checkbox" class="backlog-card__checkbox" aria-label="Pasirinkti" tabindex="-1">
      <div class="backlog-card__title"></div>
      <div class="backlog-card__badges">
        <span class="backlog-card__badge-priority"></span>
        <span class="backlog-card__badge-duedate"></span>
      </div>
      <span class="backlog-card__date"></span>
      <button type="button" class="backlog-card__toggle" aria-label="Rodyti detales" aria-expanded="false">
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </button>
      <button type="button" class="backlog-card__schedule" aria-label="Planuoti užduotį" title="Planuoti užduotį">
        <i class="bi bi-calendar-plus" aria-hidden="true"></i>
      </button>
      <button type="button" class="backlog-card__edit" aria-label="Redaguoti">
        <i class="bi bi-pencil" aria-hidden="true"></i>
      </button>
      <button type="button" class="backlog-card__delete" aria-label="Pašalinti iš eilės">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>
    <div class="backlog-card__details" hidden>
      <div class="backlog-card__detail-block backlog-card__detail--skill" hidden>
        <span class="backlog-card__detail-label">Kvalifikacija</span>
        <div class="backlog-card__skill">
          <i class="bi bi-person-check me-1" aria-hidden="true"></i>
          <span class="backlog-card__skill-value"></span>
        </div>
      </div>
      <div class="backlog-card__detail-block backlog-card__detail--object" hidden>
        <span class="backlog-card__detail-label">Objektas</span>
        <div class="backlog-card__location">
          <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>
          <span class="backlog-card__object-value"></span>
        </div>
      </div>
      <div class="backlog-card__detail-block backlog-card__detail--instructions" hidden>
        <span class="backlog-card__detail-label">Instrukcijos</span>
        <div class="backlog-card__instructions backlog-card__instructions-value"></div>
      </div>
    </div>
    <div class="backlog-card__footer"></div>
  </div>
</template>
