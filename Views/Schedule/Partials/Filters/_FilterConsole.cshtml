@using System.Linq
@model ServiceTaskPlanningSystem.Models.Planning.SchedulePageViewModel
@{
    var isWeek = string.Equals(Model.ViewMode, "week", StringComparison.OrdinalIgnoreCase);
    var dayBtnClass = isWeek ? "btn btn-outline-secondary btn-sm" : "btn btn-primary btn-sm active";
    var weekBtnClass = isWeek ? "btn btn-primary btn-sm active" : "btn btn-outline-secondary btn-sm";
    var locationOptions = Model.AvailableLocations ?? new List<string>();
    var statusOptions = Model.AvailableStatuses ?? new List<string>();
}
<div class="filter-console-trigger">
    <button type="button"
            class="btn filter-console-btn rounded-circle"
            data-bs-toggle="modal"
            data-bs-target="#filterConsoleModal"
            aria-label="Atidaryti filtravimo konsole">
        <i class="bi bi-sliders2-vertical fs-4"></i>
    </button>
    <div class="filter-console-hint shadow-sm">
        Filtrai ir veiksmai
    </div>
</div>

<div class="modal fade filter-console-modal" id="filterConsoleModal" tabindex="-1" aria-labelledby="filterConsoleLabel" aria-hidden="true" data-initial-view="@Model.ViewMode">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-1">
                <div>
                    <p class="text-muted small mb-1">Greita prieiga</p>
                    <h5 class="modal-title" id="filterConsoleLabel">Filtru ir valdikliu konsole</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>

            <div class="modal-body pt-0">
                <div class="row g-3 mb-2">
                    <div class="col-12 col-md-6" data-view-target="day">
                        <label class="form-label small mb-1">Diena</label>
                        <input type="date" class="form-control" id="filterDayDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12 col-md-6" data-view-target="week">
                        <label class="form-label small mb-1">Savaite nuo</label>
                        <input type="date" class="form-control" id="filterWeekDate" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                    </div>
                     <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">Lokacija / regionas</label>
                        <select class="form-select" id="filterLocation">
                            <option value="">Visos</option>
                            @foreach (var loc in locationOptions)
                            {
                                <option value="@loc">@loc</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">Statusas / apkrova</label>
                        <select class="form-select" id="filterStatus">
                            @foreach (var status in statusOptions)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">Rodinys</label>
                        <div class="btn-group w-100">
                            <button type="button" class="@dayBtnClass" data-view-mode="day">Diena</button>
                            <button type="button" class="@weekBtnClass" data-view-mode="week">Savaite</button>
                        </div>
                        <div class="form-text text-muted small">Pasirinkite rodini pagal, kuri kalendoriu norite matyti.</div>
                    </div>
                </div>
                <hr class="my-3" />

                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mt-3">
                    <div class="d-flex flex-wrap gap-2 filter-console-actions">
                        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" data-edit-action data-bs-toggle="modal" data-bs-target="#createTaskModal">
                            <i class="bi bi-plus-lg"></i> Sukurti uzduoti
                        </button>
                        <button class="btn btn-secondary btn-sm d-flex align-items-center gap-1" data-edit-action data-bs-toggle="modal" data-bs-target="#editTasksModal">
                            <i class="bi bi-pencil-square"></i> Redaguoti uzduotis
                        </button>
                        <button class="btn btn-warning btn-sm d-flex align-items-center gap-1" data-edit-action data-bs-toggle="modal" data-bs-target="#consoleIssuesModal">
                            <i class="bi bi-exclamation-triangle"></i> Dienos problemos
                        </button>
                    </div>
                    @if (Model.IsManager)
                    {
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="consoleEditMode" checked>
                            <label class="form-check-label" for="consoleEditMode">Redagavimo rezimas</label>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">Perziuros rezimas</div>
                    }
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <div class="w-100 d-flex flex-wrap align-items-center gap-2 justify-content-between">
                    <div class="d-flex gap-2 ms-auto">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Uzdaryti</button>
                        <button type="button" class="btn btn-primary" id="applyFiltersBtn">Taikyti filtrus</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(() => {
    const modal = document.getElementById('filterConsoleModal');
    if (!modal) return;

    const locationSelect = modal.querySelector('#filterLocation');
    const statusSelect = modal.querySelector('#filterStatus');
    const dayInput = modal.querySelector('#filterDayDate');
    const weekInput = modal.querySelector('#filterWeekDate');
    const applyBtn = modal.querySelector('#applyFiltersBtn');
    const scheduleContainer = document.getElementById('scheduleTables');
    let currentView = (modal.dataset.initialView || '').toLowerCase() === 'week' ? 'week' : 'day';

    const searchParams = new URL(window.location.href).searchParams;
    const locationParam = searchParams.get("location");
    const statusParam = searchParams.get("status");
    const dateParam = searchParams.get("date");
    if (locationSelect && locationParam) {
        locationSelect.value = locationParam;
    }
    if (statusSelect && statusParam) {
        statusSelect.value = statusParam;
    }
    if (dayInput && dateParam && currentView === "day") {
        dayInput.value = dateParam;
    }
    if (weekInput && dateParam && currentView === "week") {
        weekInput.value = dateParam;
    }

    const applyFilters = async () => {
        if (!scheduleContainer) return;
        const params = new URLSearchParams();
        params.set('view', currentView || 'day');

        const dateVal = currentView === 'week' ? (weekInput?.value || '') : (dayInput?.value || '');
        if (dateVal) {
            params.set('date', dateVal);
        }

        const loc = locationSelect?.value || '';
        if (loc) {
            params.set('location', loc);
        }

        const status = statusSelect?.value || '';
        if (status) {
            params.set('status', status);
        }

        const partialUrl = `/Schedule/Table?${params.toString()}`;
        applyBtn?.setAttribute('disabled', 'disabled');

        try {
            const response = await fetch(partialUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const html = await response.text();
            scheduleContainer.innerHTML = html;

            const newUrl = new URL(window.location.href);
            newUrl.search = params.toString();
            window.history.replaceState({}, '', newUrl.toString());

            const modalInstance = bootstrap.Modal.getInstance(modal);
            modalInstance?.hide();
        } catch (err) {
            console.error('Nepavyko atnaujinti filtro rezultatu', err);
        } finally {
            applyBtn?.removeAttribute('disabled');
        }
    };

    const viewButtons = modal.querySelectorAll('[data-view-mode]');
    const viewSections = modal.querySelectorAll('[data-view-target]');

    const setView = (mode) => {
        const normalized = (mode || '').toLowerCase() === 'week' ? 'week' : 'day';
        currentView = normalized;
        viewSections.forEach(el => {
            el.classList.toggle('d-none', (el.dataset.viewTarget || '') !== normalized);
        });
        viewButtons.forEach(btn => {
            const isActive = (btn.dataset.viewMode || '') === normalized;
            btn.classList.toggle('btn-primary', isActive);
            btn.classList.toggle('btn-outline-secondary', !isActive);
            btn.classList.toggle('active', isActive);
        });
    };

    setView(currentView);

    viewButtons.forEach(btn => {
        btn.addEventListener('click', () => setView(btn.dataset.viewMode));
    });

    if (applyBtn) {
        applyBtn.addEventListener('click', (e) => {
            e.preventDefault();
            applyFilters();
        });
    }

    const editToggle = modal.querySelector('#consoleEditMode');
    const editButtons = modal.querySelectorAll('[data-edit-action]');
    if (editToggle && editButtons.length) {
        const syncEditState = () => {
            const isOn = editToggle.checked;
            editButtons.forEach(btn => {
                btn.disabled = !isOn;
                btn.classList.toggle('disabled', !isOn);
            });
        };
        syncEditState();
        editToggle.addEventListener('change', syncEditState);
        modal.addEventListener('shown.bs.modal', syncEditState);
    }
})();
</script>

<!-- Veiksmu modalai -->
<div class="modal fade" id="createTaskModal" tabindex="-1" aria-labelledby="createTaskLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="createTaskLabel">Sukurti uzduoti</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Pavadinimas</label>
                        <input type="text" class="form-control" placeholder="Pvz.: Serverio diagnostika" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Technikas</label>
                        <select class="form-select">
                            <option>Pasirinkti</option>
                            <option>Vilnius</option>
                            <option>Kaunas</option>
                            <option>Siauliai</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Pradzia</label>
                        <input type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Pabaiga</label>
                        <input type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-1">Aprasymas</label>
                        <textarea class="form-control" rows="3" placeholder="Trumpas darbines pastabos"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Atsaukti</button>
                <button type="button" class="btn btn-primary">Issaugoti</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editTasksModal" tabindex="-1" aria-labelledby="editTasksLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="editTasksLabel">Redaguoti uzduotis</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Mock: pasirinkite uzduotis redagavimui.</p>
                <div class="list-group">
                    <label class="list-group-item d-flex align-items-center gap-2">
                        <input class="form-check-input me-1" type="checkbox" /> 09:00-11:00 Kabeliu patikra (Vilnius)
                    </label>
                    <label class="list-group-item d-flex align-items-center gap-2">
                        <input class="form-check-input me-1" type="checkbox" /> 12:00-14:00 Serverio diagnostika (Vilnius)
                    </label>
                    <label class="list-group-item d-flex align-items-center gap-2">
                        <input class="form-check-input me-1" type="checkbox" /> 16:00-18:00 Tinklo perjungimas (Klaipeda)
                    </label>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Uzdaryti</button>
                <button type="button" class="btn btn-primary">Atidaryti redagavima</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="consoleIssuesModal" tabindex="-1" aria-labelledby="consoleIssuesLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="consoleIssuesLabel">Dienos problemos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                    <div>
                        <div class="fw-semibold">Konfliktas Klaipedoje</div>
                        <div class="small text-muted">Perjungimas persidengia su Vilniaus darbu 16:00-18:00.</div>
                    </div>
                </div>
                <div class="alert alert-info d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle-fill text-info"></i>
                    <div>
                        <div class="fw-semibold">Apkrovos perziura</div>
                        <div class="small text-muted">Kaunas virsija dienos limita +1h.</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Uzdaryti</button>
                <button type="button" class="btn btn-primary">Atidaryti sprendimus</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exportPdfModal" tabindex="-1" aria-labelledby="exportPdfLabel" aria-hidden="true">
