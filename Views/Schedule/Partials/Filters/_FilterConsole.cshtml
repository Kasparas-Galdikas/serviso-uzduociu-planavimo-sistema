@model ServiceTaskPlanningSystem.Models.Planning.SchedulePageViewModel
@{
    var isWeek = string.Equals(Model.ViewMode, "week", StringComparison.OrdinalIgnoreCase);
    var dayBtnClass = isWeek ? "btn btn-outline-secondary btn-sm" : "btn btn-primary btn-sm active";
    var weekBtnClass = isWeek ? "btn btn-primary btn-sm active" : "btn btn-outline-secondary btn-sm";
}
<div class="filter-console-trigger">
    <button type="button"
            class="btn filter-console-btn rounded-circle"
            data-bs-toggle="modal"
            data-bs-target="#filterConsoleModal"
            aria-label="Atidaryti filtravimo konsole">
        <i class="bi bi-sliders2-vertical fs-4"></i>
    </button>
    <div class="filter-console-hint shadow-sm">
        Filtrai ir veiksmai
    </div>
</div>

<div class="modal fade filter-console-modal" id="filterConsoleModal" tabindex="-1" aria-labelledby="filterConsoleLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-1">
                <div>
                    <p class="text-muted small mb-1">Greita prieiga</p>
                    <h5 class="modal-title" id="filterConsoleLabel">Filtru ir valdikliu konsole</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>

            <div class="modal-body pt-0">
                <div class="row g-3 mb-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">Diena</label>
                        <input type="date" class="form-control" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">Savaite nuo</label>
                        <input type="date" class="form-control" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">Technikas</label>
                        <select class="form-select">
                            <option>Visi</option>
                            <option>Vilnius</option>
                            <option>Kaunas</option>
                            <option>Siauliai</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">Lokacija / regionas</label>
                        <select class="form-select">
                            <option>Visos</option>
                            <option>Vilnius</option>
                            <option>Kaunas</option>
                            <option>Siauliai</option>
                            <option>Klaipeda</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">Statusas / prioritetas</label>
                        <select class="form-select">
                            <option>Visi</option>
                            <option>Aukstas</option>
                            <option>Vidutinis</option>
                            <option>Zemas</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">Rodinys</label>
                        <div class="btn-group w-100">
                            <button type="button" class="@dayBtnClass" data-view-mode="day">Diena</button>
                            <button type="button" class="@weekBtnClass" data-view-mode="week">Savaite</button>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mt-3">
                    <div class="d-flex flex-wrap gap-2 filter-console-actions">
                        <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createTaskModal">
                            <i class="bi bi-plus-lg"></i> Sukurti uzduoti
                        </button>
                        <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#editTasksModal">
                            <i class="bi bi-pencil-square"></i> Redaguoti uzduotis
                        </button>
                        <button class="btn btn-outline-warning btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#consoleIssuesModal">
                            <i class="bi bi-exclamation-triangle"></i> Dienos problemos
                        </button>
                        <div class="btn-group dropup">
                            <button class="btn btn-outline-success btn-sm dropdown-toggle d-flex align-items-center gap-1" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-box-arrow-down"></i> Eksportas
                            </button>
                            <ul class="dropdown-menu">
                                <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#exportPdfModal">Eksportuoti i PDF</button></li>
                                <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#exportExcelModal">Eksportuoti i Excel</button></li>
                                <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#exportCsvModal">Eksportuoti i CSV</button></li>
                            </ul>
                        </div>
                    </div>
                    @if (Model.IsManager)
                    {
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="consoleEditMode" checked>
                            <label class="form-check-label" for="consoleEditMode">Redagavimo rezimas</label>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">Perziuros rezimas</div>
                    }
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <div class="w-100 d-flex flex-wrap align-items-center gap-2 justify-content-between">
                    <span class="text-muted small">Mock: filtrai nerodo realiu duomenu</span>
                    <div class="d-flex gap-2 ms-auto">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Uzdaryti</button>
                        <button type="button" class="btn btn-primary" id="applyFiltersBtn">Taikyti filtrus</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Veiksmu modalai -->
<div class="modal fade" id="createTaskModal" tabindex="-1" aria-labelledby="createTaskLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="createTaskLabel">Sukurti uzduoti</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Pavadinimas</label>
                        <input type="text" class="form-control" placeholder="Pvz.: Serverio diagnostika" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Technikas</label>
                        <select class="form-select">
                            <option>Pasirinkti</option>
                            <option>Vilnius</option>
                            <option>Kaunas</option>
                            <option>Siauliai</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Pradzia</label>
                        <input type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Pabaiga</label>
                        <input type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-1">Aprasymas</label>
                        <textarea class="form-control" rows="3" placeholder="Trumpas darbines pastabos"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Atsaukti</button>
                <button type="button" class="btn btn-primary">Issaugoti</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editTasksModal" tabindex="-1" aria-labelledby="editTasksLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="editTasksLabel">Redaguoti uzduotis</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Mock: pasirinkite uzduotis redagavimui.</p>
                <div class="list-group">
                    <label class="list-group-item d-flex align-items-center gap-2">
                        <input class="form-check-input me-1" type="checkbox" /> 09:00-11:00 Kabeliu patikra (Vilnius)
                    </label>
                    <label class="list-group-item d-flex align-items-center gap-2">
                        <input class="form-check-input me-1" type="checkbox" /> 12:00-14:00 Serverio diagnostika (Vilnius)
                    </label>
                    <label class="list-group-item d-flex align-items-center gap-2">
                        <input class="form-check-input me-1" type="checkbox" /> 16:00-18:00 Tinklo perjungimas (Klaipeda)
                    </label>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Uzdaryti</button>
                <button type="button" class="btn btn-primary">Atidaryti redagavima</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="consoleIssuesModal" tabindex="-1" aria-labelledby="consoleIssuesLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="consoleIssuesLabel">Dienos problemos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                    <div>
                        <div class="fw-semibold">Konfliktas Klaipedoje</div>
                        <div class="small text-muted">Perjungimas persidengia su Vilniaus darbu 16:00-18:00.</div>
                    </div>
                </div>
                <div class="alert alert-info d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle-fill text-info"></i>
                    <div>
                        <div class="fw-semibold">Apkrovos perziura</div>
                        <div class="small text-muted">Kaunas virsija dienos limita +1h.</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Uzdaryti</button>
                <button type="button" class="btn btn-primary">Atidaryti sprendimus</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exportPdfModal" tabindex="-1" aria-labelledby="exportPdfLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="exportPdfLabel">Eksportas i PDF</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Mock forma: pasirinkite perioda ir komponentus.</p>
                <div class="mb-2">
                    <label class="form-label small mb-1">Periodas</label>
                    <select class="form-select">
                        <option>Sios dienos</option>
                        <option>Sios savaites</option>
                        <option>Pasirinktas intervalas</option>
                    </select>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="pdfIncludeIssues" checked>
                    <label class="form-check-label" for="pdfIncludeIssues">Ittraukti problemu ataskaita</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="pdfIncludeTasks" checked>
                    <label class="form-check-label" for="pdfIncludeTasks">Ittraukti uzduociu sarasa</label>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Atsaukti</button>
                <button type="button" class="btn btn-success">Generuoti PDF</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exportExcelModal" tabindex="-1" aria-labelledby="exportExcelLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="exportExcelLabel">Eksportas i Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">Mock: pasirinkite laksto tipa.</p>
                <div class="form-check mb-1">
                    <input class="form-check-input" type="radio" name="excelExportType" id="excelSummary" checked>
                    <label class="form-check-label" for="excelSummary">Santrauka</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="excelExportType" id="excelDetailed">
                    <label class="form-check-label" for="excelDetailed">Detali lentele su laiko slotais</label>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Atsaukti</button>
                <button type="button" class="btn btn-success">Eksportuoti</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exportCsvModal" tabindex="-1" aria-labelledby="exportCsvLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="exportCsvLabel">Eksportas i CSV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uzdaryti"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">Mock: pasirinkite kokius laukus eksportuoti.</p>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="csvIncludeTasks" checked>
                    <label class="form-check-label" for="csvIncludeTasks">Uzduociu pavadinimai ir laikas</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="csvIncludeTechnicians" checked>
                    <label class="form-check-label" for="csvIncludeTechnicians">Techniku meta duomenys</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="csvIncludeIssues">
                    <label class="form-check-label" for="csvIncludeIssues">Problemu sarasas</label>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Atsaukti</button>
                <button type="button" class="btn btn-success">Eksportuoti</button>
            </div>
        </div>
    </div>
</div>
