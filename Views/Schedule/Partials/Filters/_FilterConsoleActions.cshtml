@model ServiceTaskPlanningSystem.Models.Planning.SchedulePageViewModel
@{
    var canEdit = Model.IsManager;
    var prefix = (ViewData["FilterPrefix"] as string) ?? string.Empty;
    if (string.IsNullOrWhiteSpace(prefix))
    {
        throw new InvalidOperationException("FilterPrefix is required");
    }

    var editModeId = $"{prefix}-consoleEditMode";
}
<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mt-3">
    <div class="d-flex flex-wrap gap-2 filter-console-actions">
        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 @(canEdit ? string.Empty : "disabled")"
            data-edit-action data-bs-toggle="modal" data-bs-target="#createTaskModal" @(canEdit ? "" : "disabled")>
            <i class="bi bi-plus-lg"></i> Sukurti tvarkarasti
        </button>
        <li class="nav-item ms-2 d-flex align-items-center">
            <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Task" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i>
                Užregistruoti užduotį
            </a>
        </li>
    </div>
    @if (Model.IsManager)
    {
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="@editModeId" data-edit-toggle checked>
            <label class="form-check-label" for="@editModeId">Redagavimo rezimas</label>
        </div>
    }
    else
    {
        <div class="text-muted small">Perziuros rezimas</div>
    }
</div>