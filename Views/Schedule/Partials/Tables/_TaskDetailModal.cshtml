<div class="offcanvas offcanvas-end task-detail-panel" tabindex="-1" id="taskDetailModal"
    aria-labelledby="taskDetailLabel" data-bs-scroll="true" data-bs-backdrop="false">

    <div class="task-detail-resize-handle" data-panel-resize aria-label="Keisti skydelio ploti"></div>

    <button type="button" class="btn btn-light task-detail-collapse" data-panel-toggle
        aria-label="Suskleisti / išskleisti skydeli" aria-pressed="false">
        <span data-panel-toggle-icon>&gt;</span>
    </button>

    <div class="offcanvas-header border-bottom">
        <div>
            <h5 class="offcanvas-title" id="taskDetailLabel">Užduoties informacija</h5>
            <small class="text-muted" id="taskDetailCode">Kodas: —</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Uždaryti"></button>
    </div>

    <div class="offcanvas-body">

        <div class="alert alert-info d-none mb-3" id="taskDetailReadonlyNote">
            Aktyvaus plano užduotys yra tik peržiurai.
            Redaguoti galima tik juodrašcio plano užduotis.
        </div>

        <!-- PLANAVIMAS -->
        <section class="mb-4 task-section">
            <div class="task-section-header" role="button" tabindex="0" data-bs-toggle="collapse"
                data-bs-target="#taskSecPlanning" aria-expanded="true" aria-controls="taskSecPlanning">

                <h6 class="text-uppercase small mb-0 task-section-title" data-task-section-title="true">
                    Planavimas
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle" data-bs-toggle="collapse"
                    data-bs-target="#taskSecPlanning" aria-expanded="true" aria-controls="taskSecPlanning">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="taskSecPlanning">
                <div class="row g-3 mt-1">

                    <div class="col-md-6">
                        <label class="form-label small">Pavadinimas</label>
                        <input type="text" class="form-control" id="taskDetailTitle">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small">Priskirtas darbuotojas</label>
                        <select class="form-select" id="taskDetailAssignee"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small">Pradžia</label>
                        <input type="datetime-local" class="form-control" id="taskDetailStart">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small">Pabaiga</label>
                        <input type="datetime-local" class="form-control" id="taskDetailEnd">
                    </div>

                </div>
            </div>
            <hr>
        </section>

        <!-- UŽDUOTIES PARAMETRAI -->
        <section class="mb-4 task-section">
            <div class="task-section-header" role="button" tabindex="0" data-bs-toggle="collapse"
                data-bs-target="#taskSecParams" aria-expanded="true" aria-controls="taskSecParams">

                <h6 class="text-uppercase small mb-0 task-section-title" data-task-section-title="true">
                    Užduoties parametrai
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle" data-bs-toggle="collapse"
                    data-bs-target="#taskSecParams" aria-expanded="true" aria-controls="taskSecParams">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="taskSecParams">
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label small">Reikalingas kvalifikacijos lygis</label>
                        <select class="form-select" id="taskDetailSkill">
                            <option value="Basic">Bazinis</option>
                            <option value="Advanced">Paženges</option>
                            <option value="Certified">Sertifikuotas</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small">Prioritetas</label>
                        <select class="form-select" id="taskDetailPriority">
                            <option value="Low">Žemas</option>
                            <option value="Medium">Vidutinis</option>
                            <option value="High">Aukštas</option>
                        </select>
                    </div>
                </div>
            </div>
            <hr>
        </section>

        <!-- SAUGOMAS OBJEKTAS -->
        <section class="mb-4 task-section">
            <div class="task-section-header" role="button" tabindex="0" data-bs-toggle="collapse"
                data-bs-target="#taskSecAsset">

                <h6 class="text-uppercase small mb-0 task-section-title" data-task-section-title="true">
                    Saugomas objektas
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle" data-bs-toggle="collapse"
                    data-bs-target="#taskSecAsset">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="taskSecAsset">
                <div class="row g-3 mt-1">

                    <!-- Object dropdown -->
                    <div class="col-md-6">
                        <label class="form-label small">Objektas</label>
                        <select class="form-select" id="taskDetailObject">
                            <option value="">— Pasirinkite objekta —</option>
                            <option value="1" data-address="Savanoriu pr. 321A, Kaunas">Sandelis A</option>
                            <option value="2" data-address="Statybininku g. 12, Vilnius">Serverine</option>
                            <option value="3" data-address="Partizanu g. 5, Kaunas">Tinklu skyrius</option>
                        </select>
                    </div>

                    <!-- Auto-filled address -->
                    <div class="col-md-6">
                        <label class="form-label small">Adresas / Lokacija</label>
                        <input type="text" class="form-control" id="taskDetailLocation" readonly
                            placeholder="Pasirinkus objekta adresas bus užpildytas automatiškai">
                    </div>

                </div>
            </div>
            <hr>
        </section>

        <!-- INSTRUKCIJOS IR SAUGA -->
        <section class="mb-4 task-section" id="managerSection">
            <div class="task-section-header" role="button" tabindex="0" data-bs-toggle="collapse"
                data-bs-target="#taskSecSafety">

                <h6 class="text-uppercase small mb-0 task-section-title" data-task-section-title="true">
                    Instrukcijos ir sauga
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle" data-bs-toggle="collapse"
                    data-bs-target="#taskSecSafety">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse" id="taskSecSafety">
                <div class="row g-3 mt-1">

                    <div class="col-12">
                        <label class="form-label small">Instrukcijos darbuotojui</label>
                        <textarea class="form-control" rows="3" id="taskDetailInstructions"></textarea>
                        <div id="taskDetailInstructionsReadonly" class="form-control-plaintext border rounded p-2 d-none"
                            style="white-space: pre-line;"></div>
                    </div>
                </div>
            </div>
            <hr>
        </section>

        <!-- DARBUOTOJO PASTABOS (TECHNICIAN SECTION) -->
        <section class="mb-4 task-section" id="technicianSection">
            <div class="task-section-header" role="button" tabindex="0" data-bs-toggle="collapse"
                data-bs-target="#taskSecTechnician">

                <h6 class="text-uppercase small mb-0 task-section-title" data-task-section-title="true">
                    Darbuotojo pastabos
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle" data-bs-toggle="collapse"
                    data-bs-target="#taskSecTechnician">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="taskSecTechnician">
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label small">Statusas</label>
                        <select class="form-select" id="taskDetailStatus">
                            <option value="" disabled selected>— Pakeiskite busena —</option>
                            <option value="Completed">Baigta</option>
                            <option value="Canceled">Atšaukta</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Komentaras</label>
                        <textarea class="form-control" rows="3" id="taskDetailTechnicianComment"
                            placeholder="Darbuotojo pastabos apie užduoties vykdyma..."></textarea>
                        <small class="form-text text-muted">Darbuotojai gali palikti darbo komentara</small>
                    </div>
                </div>
            </div>
            <hr>
        </section>

        <!-- FOOTER -->
        <div class="d-flex justify-content-between gap-2 border-top pt-3 mt-4">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">
                Uždaryti
            </button>
            <button type="button" class="btn btn-primary" id="taskDetailSave">
                Išsaugoti
            </button>
        </div>

    </div>

</div>

<script>
    document.addEventListener('schedule:table:updated', () => {
        const tables = document.getElementById('scheduleTables');
        if (!tables) return;

        tables.setAttribute(
            'data-is-manager',
            tables.dataset.isManager || ''
        );
    });
</script>

