@using ServiceTaskPlanningSystem.Data
<div class="offcanvas offcanvas-end task-detail-panel" tabindex="-1" id="taskDetailModal"
     aria-labelledby="taskDetailLabel" data-bs-scroll="true" data-bs-backdrop="false">

    <div class="task-detail-resize-handle" data-panel-resize aria-label="Keisti skydelio plotį"></div>

    <button type="button" class="btn btn-light task-detail-collapse" data-panel-toggle
            aria-label="Suskleisti / išskleisti skydelį" aria-pressed="false">
        <span data-panel-toggle-icon>&gt;</span>
    </button>

    <div class="offcanvas-header border-bottom">
        <div class="offcanvas-title-wrap">
            <h5 class="offcanvas-title" id="taskDetailLabel" data-task-title="Užduoties informacija" data-history-title="Veiksmų istorija">Užduoties informacija</h5>
            <small class="text-muted" id="taskDetailCode" data-task-subtitle="Kodas:" data-history-subtitle="">Kodas:</small>
            <small class="text-muted d-none" id="taskDetailHistorySubtitle">Naujausi veiksmai rodomi viršuje</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Uždaryti"></button>
    </div>

    <div class="offcanvas-body">

        <!-- Backlog tab bar — visible only in backlog mode -->
        <div id="backlogTabBar" class="d-none mb-2">
            <p class="backlog-section-label mb-1">Veiksmas</p>
            <div class="btn-group w-100" role="group" aria-label="Laukiančių darbų valdymas">
                <button type="button" class="btn btn-primary active backlog-tab-btn" id="backlogTabCreate" data-backlog-tab="create">
                    <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Sukurti
                </button>
                <button type="button" class="btn btn-outline-secondary backlog-tab-btn" id="backlogTabList" data-backlog-tab="list">
                    <i class="bi bi-list-ul me-1" aria-hidden="true"></i>Sąrašas
                </button>
            </div>
        </div>

        <!-- Task Content Container -->
        <div id="taskPanelContent">

        <!-- Bulk scheduling progress indicator — visible only during bulk queue -->
        <div id="taskBulkProgress" class="task-bulk-progress d-none">
            <span id="taskBulkProgressStep" class="task-bulk-progress__step"></span>
            <span id="taskBulkProgressTitle" class="task-bulk-progress__title text-muted"></span>
        </div>

        <!-- PLANAVIMAS -->
        <section class="mb-4 task-section">
            <div class="task-section-header" role="button" tabindex="0"
                 data-bs-toggle="collapse"
                 data-bs-target="#taskSecPlanning"
                 aria-expanded="true"
                 aria-controls="taskSecPlanning">

                <h6 class="text-uppercase small mb-0 task-section-title">
                    Planavimas
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle"
                        data-bs-toggle="collapse"
                        data-bs-target="#taskSecPlanning"
                        aria-expanded="true"
                        aria-controls="taskSecPlanning">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="taskSecPlanning">
                <div class="row g-3 mt-1">

                    <div class="col-md-6">
                        <label class="form-label small">Pavadinimas</label>
                        <input type="text" class="form-control" id="taskDetailTitle">
                    </div>

                    <div class="col-md-6" id="taskFieldAssignee">
                        <label class="form-label small">Priskirtas darbuotojas</label>
                        <select class="form-select" id="taskDetailAssignee"
                                data-select2-dropdown="technician"></select>
                    </div>

                    <div class="col-md-6 d-none" id="backlogTypeField">
                        <label class="form-label small">Šablono tipas</label>
                        <select class="form-select" id="backlogItemType">
                            <option value="" disabled selected>– Pasirinkite tipą –</option>
                            <option value="@((int)BacklogItemType.Temporary)">Laikinas</option>
                            <option value="@((int)BacklogItemType.Permanent)">Nuolatinis</option>
                        </select>
                    </div>

                    <div class="col-md-6 d-none" id="backlogDueDateField">
                        <label class="form-label small">Terminas <span class="text-muted">(nebūtinas)</span></label>
                        <input type="date" class="form-control" id="backlogDueDate">
                    </div>

                    <div class="col-md-6" id="taskFieldStart">
                        <label class="form-label small">Pradžia</label>
                        <input type="datetime-local" class="form-control" id="taskDetailStart">
                    </div>

                    <div class="col-md-6" id="taskFieldEnd">
                        <label class="form-label small">Pabaiga</label>
                        <input type="datetime-local" class="form-control" id="taskDetailEnd">
                    </div>

                    <div class="col-12 d-none" id="planModeField">
                        <label class="form-label small">Planavimo režimas</label>
                        <div class="btn-group w-100" role="group" aria-label="Planavimo režimas">
                            <input type="radio" class="btn-check" name="taskPlanModeRadio" id="taskPlanModeRankinis" value="rankinis" autocomplete="off">
                            <label class="btn btn-outline-primary" for="taskPlanModeRankinis">Rankinis</label>
                            <input type="radio" class="btn-check" name="taskPlanModeRadio" id="taskPlanModeAutomatinis" value="automatinis" autocomplete="off">
                            <label class="btn btn-outline-primary" for="taskPlanModeAutomatinis">Automatinis</label>
                        </div>
                        <input type="hidden" id="taskPlanMode" value="">
                    </div>

                </div>
            </div>
            <hr>
        </section>

        <!-- UŽDUOTIES PARAMETRAI -->
        <section class="mb-4 task-section">
            <div class="task-section-header" role="button" tabindex="0"
                 data-bs-toggle="collapse"
                 data-bs-target="#taskSecParams"
                 aria-expanded="true"
                 aria-controls="taskSecParams">

                <h6 class="text-uppercase small mb-0 task-section-title">
                    Užduoties parametrai
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle"
                        data-bs-toggle="collapse"
                        data-bs-target="#taskSecParams"
                        aria-expanded="true"
                        aria-controls="taskSecParams">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="taskSecParams">
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label small">Reikalingas kvalifikacijos lygis</label>
                        <select class="form-select" id="taskDetailSkill">
                            <option value="">– Pasirinkite kvalifikaciją –</option>
                            <option value="Basic">Bazinis</option>
                            <option value="Advanced">Pažengęs</option>
                            <option value="Certified">Sertifikuotas</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small">Prioritetas</label>
                        <select class="form-select" id="taskDetailPriority">
                            <option value="">– Pasirinkite prioritetą –</option>
                            <option value="@((int)TaskPriority.Low)">Žemas</option>
                            <option value="@((int)TaskPriority.Medium)">Vidutinis</option>
                            <option value="@((int)TaskPriority.High)">Aukštas</option>
                        </select>
                    </div>
                </div>
            </div>
            <hr>
        </section>

        <!-- SAUGOMAS OBJEKTAS -->
        <section class="mb-4 task-section" id="taskSectionAsset">
            <div class="task-section-header" role="button" tabindex="0"
                 data-bs-toggle="collapse"
                 data-bs-target="#taskSecAsset">

                <h6 class="text-uppercase small mb-0 task-section-title">
                    Saugomas objektas
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle"
                        data-bs-toggle="collapse"
                        data-bs-target="#taskSecAsset">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="taskSecAsset">
                <div class="row g-3 mt-1">

                    <div class="col-md-6">
                        <label class="form-label small">Objektas</label>
                        <select class="form-select" id="taskDetailObject"
                                data-select2-dropdown="object"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small">Adresas</label>
                        <select class="form-select" id="taskDetailLocation"
                                data-select2-dropdown="address"></select>
                    </div>

                </div>
            </div>
            <hr>
        </section>

        <!-- INSTRUKCIJOS IR SAUGA -->
        <section class="mb-4 task-section" id="managerSection">
            <div class="task-section-header" role="button" tabindex="0"
                 data-bs-toggle="collapse"
                 data-bs-target="#taskSecSafety">

                <h6 class="text-uppercase small mb-0 task-section-title">
                    Instrukcijos ir sauga
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle"
                        data-bs-toggle="collapse"
                        data-bs-target="#taskSecSafety">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse" id="taskSecSafety">
                <div class="row g-3 mt-1">
                    <div class="col-12">
                        <label class="form-label small">Instrukcijos darbuotojui</label>
                        <textarea class="form-control" rows="3" id="taskDetailInstructions"></textarea>
                        <div id="taskDetailInstructionsReadonly"
                             class="form-control-plaintext border rounded p-2 d-none"
                             style="white-space: pre-line;"></div>
                    </div>
                </div>
            </div>
            <hr>
        </section>

        <!-- DARBUOTOJO PASTABOS -->
        <section class="mb-4 task-section" id="technicianSection">
            <div class="task-section-header" role="button" tabindex="0"
                 data-bs-toggle="collapse"
                 data-bs-target="#taskSecTechnician">

                <h6 class="text-uppercase small mb-0 task-section-title">
                    Darbuotojo pastabos
                </h6>

                <button type="button" class="btn btn-sm btn-ghost task-section-toggle"
                        data-bs-toggle="collapse"
                        data-bs-target="#taskSecTechnician">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="taskSecTechnician">
                <div class="row g-3 mt-1">
                    <div class="col-md-6" id="taskDetailStatusContainer">
                        <label class="form-label small">Statusas</label>
                        <select class="form-select" id="taskDetailStatus">
                            <option value="@((int)ScheduleTaskStatus.Completed)">Atlikta</option>
                            <option value="@((int)ScheduleTaskStatus.Conflict)">Problema</option>
                        </select>
                        <div id="taskDetailStatusReadonly"
                             class="form-select d-none"
                             style="display: flex; align-items: center; cursor: default; background-color: #e9ecef; color: #495057;"></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Komentaras</label>
                        <textarea class="form-control" rows="3"
                                  id="taskDetailTechnicianComment"
                                  placeholder="Darbuotojo pastabos apie užduoties vykdymą..."></textarea>
                        <small class="form-text text-muted">
                            Čia darbuotojai gali palikti darbo komentarą
                        </small>
                    </div>
                </div>
            </div>
            <hr>
        </section>

        </div>

        <!-- History Content Container -->
        @await Html.PartialAsync("~/Views/Schedule/Partials/_HistoryContent.cshtml")

        <!-- Backlog List Container — shown when list tab is active -->
        <div id="backlogPanelContent" style="display: none;">
            <hr class="backlog-section-divider">
            <div id="backlogTypeTabBar">
                <p class="backlog-section-label">Sąrašo tipas</p>
                <div class="btn-group btn-group-sm w-100" role="group">
                    <button id="backlogTypeTabTemp" type="button" class="btn btn-outline-secondary">Laikini <span class="badge ms-1 backlog-type-badge" id="backlogCountTemp">0</span></button>
                    <button id="backlogTypeTabPerm" type="button" class="btn btn-outline-secondary active">Nuolatiniai <span class="badge ms-1 backlog-type-badge" id="backlogCountPerm">0</span></button>
                </div>
            </div>
            <hr class="backlog-section-divider">
            <div class="backlog-list-header">
                <div class="backlog-lh-normal">
                    <p class="backlog-section-label mb-0">Sąrašas</p>
                    <button type="button" id="backlogSelectToggle" class="btn btn-outline-secondary backlog-select-toggle-btn">
                        <i class="bi bi-check2-square me-1" aria-hidden="true"></i>Pasirinkti
                    </button>
                </div>
                <div class="backlog-lh-selecting">
                    <p class="backlog-section-label mb-0">Sąrašas</p>
                    <div class="d-flex gap-1 ms-auto">
                        <button type="button" id="backlogBulkDelete" class="btn btn-outline-danger backlog-select-toggle-btn" title="Ištrinti pasirinktus" disabled>
                            <i class="bi bi-trash me-1" aria-hidden="true"></i>Ištrinti
                        </button>
                        <button type="button" id="backlogSelectCancel" class="btn btn-outline-secondary backlog-select-toggle-btn" title="Atšaukti pasirinkimą">
                            <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Atšaukti
                        </button>
                    </div>
                </div>
            </div>
            <div class="backlog-drag-hint">
                <i class="bi bi-arrows-move me-1" aria-hidden="true"></i>
                Nutempkite užduoties kortelę į grafiką ir paleiskite norimoje vietoje
            </div>
            <div id="backlogListEmpty" class="text-center text-muted py-4 d-none">
                <i class="bi bi-inbox fs-3 d-block mb-2" aria-hidden="true"></i>
                <div class="small">sąrašas tuščias. Sukurkite naują įrašą.</div>
            </div>
            <div id="backlogItemsList"></div>
            <div id="backlogBulkBar" class="backlog-bulk-bar">
                <label class="backlog-bulk-selectall-wrap">
                    <input type="checkbox" id="backlogSelectAll" class="backlog-bulk-selectall" aria-label="Pasirinkti visus">
                    <span id="backlogBulkCount" class="backlog-bulk-count">Nepasirinkta</span>
                </label>
                <button type="button" id="backlogBulkSchedule" class="btn btn-sm btn-primary" disabled>
                    <i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>Planuoti
                </button>
            </div>
        </div>

        <!-- Technician unavailability panel — shown when a technician name is clicked -->
        <div id="technicianPanelContent" style="display: none;">
            @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_TechnicianPanel.cshtml")
        </div>

        <!-- Bulk confirm view — shown instead of form sections during confirm phase -->
        <div id="taskBulkConfirmView" class="d-none px-1 py-2">
            <div class="fw-semibold mb-3">Plano santrauka</div>
            <div id="taskBulkConfirmList"></div>
        </div>

        <!-- FOOTER -->
        <div id="taskDetailFooter" class="d-flex justify-content-between gap-2 border-top pt-3 mt-4">
            <button type="button" class="btn btn-secondary" id="taskFooterClose" data-bs-dismiss="offcanvas">
                Uždaryti
            </button>
            <button type="button" class="btn btn-outline-secondary d-none" id="taskBulkBack">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Atgal
            </button>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary" id="taskDetailSave">
                    Išsaugoti
                </button>
                <button type="button" class="btn btn-primary d-none" id="backlogSaveBtn">
                    <i class="bi bi-inbox me-1" aria-hidden="true"></i>Įtraukti į sąrašą
                </button>
                <button type="button" class="btn btn-primary d-none" id="taskBulkNext">
                    Kitas <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </button>
            </div>
        </div>

    </div>
</div>

<script>
document.addEventListener('schedule:table:updated', () => {
    const tables = document.getElementById('scheduleTables');
    if (!tables) return;

    tables.setAttribute(
        'data-is-manager',
        tables.dataset.isManager || ''
    );
});
</script>
