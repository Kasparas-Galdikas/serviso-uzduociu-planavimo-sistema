@model ServiceTaskPlanningSystem.Models.Planning.SchedulePageViewModel
@using ServiceTaskPlanningSystem.Models.Planning

@{
    var layout = Model.DailyLayout;
    if (layout == null)
    {
        <div class="alert alert-warning">Grafiko duomenys neprieinami.</div>
        return;
    }

    var tableModel = layout.Table;
    var headerLabel = layout.HeaderLabel;
    var isToday = layout.IsToday;
    var isPreview = Model.IsPreviewMode &&
                    Model.PlannedPeriodStart != default(DateTime) &&
                    Model.SelectedDate.Date >= Model.PlannedPeriodStart.Date &&
                    Model.SelectedDate.Date <= Model.PlannedPeriodEnd.Date;
}

<div class="card p-3 mb-4">

    <!-- HEADER -->
    <div class="d-flex align-items-center mb-3">
        <div class="fw-semibold @(isToday ? "today-label" : string.Empty)">@headerLabel</div>
        <h5 class="mb-0 flex-grow-1 text-center">Dienos grafikas</h5>
        <div class="d-flex align-items-center gap-2">
            @if (isPreview)
            {
                <span class="badge bg-warning text-dark">Generavimo perziura</span>
            }
        </div>
    </div>

    @{
        ViewData["InformationType"] = Model.InformationType;
    }
    @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_Legend.cshtml")
    
    <div class="mt-2">
        @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_ViewNavigation.cshtml", Model)
    </div>

    <!-- SCHEDULE TABLE -->
    @{
        ViewData["StickyTable"] = true;
    }
    @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_TableShell.cshtml", tableModel)

    <div class="mt-2">
        @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_ViewNavigation.cshtml", Model)
    </div>
</div>
