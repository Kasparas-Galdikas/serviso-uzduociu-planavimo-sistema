<div class="px-1 py-2">

    <!-- Technikas -->
    <div class="backlog-section-label mb-2">Technikas</div>
    <div class="fw-semibold mb-3" id="technicianPanelName"></div>

    <hr class="my-3">

    <!-- Naujas periodas -->
    <div class="backlog-section-label mb-2">Naujas neaktyvumo periodas</div>

    <div class="d-flex gap-2 mb-2">
        <div class="flex-fill">
            <label class="form-label small mb-1" for="unavailStart">Nuo</label>
            <input type="datetime-local" id="unavailStart" class="form-control form-control-sm" step="1800">
            <div class="form-text text-danger d-none" id="unavailStartError"></div>
        </div>
        <div class="flex-fill">
            <label class="form-label small mb-1" for="unavailEnd">Iki</label>
            <input type="datetime-local" id="unavailEnd" class="form-control form-control-sm" step="1800">
            <div class="form-text text-danger d-none" id="unavailEndError"></div>
        </div>
    </div>

    <hr class="my-3">

    <div id="unavailPreviewResult" class="mb-3" style="display: none;">
        <div class="backlog-section-label mb-2" id="unavailPreviewHeading">
            Paveiktos užduotys
        </div>
        <div id="unavailPreviewList" class="mb-2"></div>
    </div>

    <button id="unavailConfirmBtn" type="button" class="btn btn-primary btn-sm w-100 mb-3">
        Patvirtinti
    </button>

    <hr class="my-3">

    <!-- Sąrašas -->
    <div class="backlog-section-label mb-2">Neaktyvumo periodų sąrašas</div>
    <div id="unavailPeriodsList">
        <span class="text-muted small">Kraunama...</span>
    </div>

</div>