@model ServiceTaskPlanningSystem.Models.Planning.TableShellModel

@{
    var stickyTable = (ViewData["StickyTable"] as bool?) ?? false;
    var wrapperClass = stickyTable ? "table-responsive table-fixed-head" : "table-responsive";
}

<div class="@wrapperClass">
    <table class="table table-bordered @Model.TableCssClass">
        <thead class="table-light @(stickyTable ? "thead-top" : string.Empty)">
            <tr>
                <th style="width:@Model.FirstColumnWidth">@Model.FirstColumnTitle</th>
                @foreach (var col in Model.Columns)
                {
                    <th class="text-center time-header @(string.IsNullOrEmpty(col.CssClass) ? "" : col.CssClass)"
                        style="@(string.IsNullOrEmpty(col.Width) ? string.Empty : $"width:{col.Width}")">
                        @col.Title
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <th class="align-top tech-cell">@Html.Raw(row.HeaderHtml)</th>
                    @foreach (var cell in row.Cells)
                    {
                        <td class="@cell.CssClass" colspan="@cell.ColSpan">@Html.Raw(cell.ContentHtml)</td>
                    }
                </tr>
            }
        </tbody>
        <thead class="table-light">
            <tr>
                <th style="width:@Model.FirstColumnWidth">@Model.FirstColumnTitle</th>
                @foreach (var col in Model.Columns)
                {
                    <th class="text-center time-header @(string.IsNullOrEmpty(col.CssClass) ? "" : col.CssClass)"
                        style="@(string.IsNullOrEmpty(col.Width) ? string.Empty : $"width:{col.Width}")">
                        @col.Title
                    </th>
                }
            </tr>
        </thead>
    </table>
</div>
