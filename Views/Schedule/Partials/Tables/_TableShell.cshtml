@model ServiceTaskPlanningSystem.Models.Planning.TableShellModel

@{
    var stickyTable = (ViewData["StickyTable"] as bool?) ?? false;
    var wrapperClass = stickyTable ? "table-responsive table-fixed-head" : "table-responsive";
}

<div class="@wrapperClass">
    <table class="table table-bordered @Model.TableCssClass">
        <thead class="table-light @(stickyTable ? "thead-top" : string.Empty)">
            <tr>
                <th class="tech-cell tech-col-head" style="width:@Model.FirstColumnWidth">@Model.FirstColumnTitle</th>
                @foreach (var col in Model.Columns)
                {
                    <th class="text-center time-header @(string.IsNullOrEmpty(col.CssClass) ? "" : col.CssClass)"
                        style="@(string.IsNullOrEmpty(col.Width) ? string.Empty : $"width:{col.Width}")">
                        @col.Title
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <th class="align-top tech-cell">
                        @if (row.TechnicianInfo != null)
                        {
                            @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_TechnicianHeader.cshtml", row.TechnicianInfo)
                        }
                        else
                        {
                            @Html.Raw(row.HeaderHtml)
                        }
                    </th>
                    @foreach (var cell in row.Cells)
                    {
                        <td class="@cell.CssClass" colspan="@cell.ColSpan">
                            @if (cell.DailyData != null)
                            {
                                @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_DailyCell.cshtml", cell.DailyData)
                            }
                            else if (cell.WeeklyData != null)
                            {
                                @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_WeeklyCell.cshtml", cell.WeeklyData)
                            }
                            else
                            {
                                @Html.Raw(cell.ContentHtml)
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
        <thead class="table-light">
            <tr>
                <th class="tech-cell tech-col-head" style="width:@Model.FirstColumnWidth">@Model.FirstColumnTitle</th>
                @foreach (var col in Model.Columns)
                {
                    <th class="text-center time-header @(string.IsNullOrEmpty(col.CssClass) ? "" : col.CssClass)"
                        style="@(string.IsNullOrEmpty(col.Width) ? string.Empty : $"width:{col.Width}")">
                        @col.Title
                    </th>
                }
            </tr>
        </thead>
    </table>
</div>
