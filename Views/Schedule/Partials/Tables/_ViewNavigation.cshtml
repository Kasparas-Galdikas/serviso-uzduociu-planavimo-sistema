@model ServiceTaskPlanningSystem.Models.Planning.SchedulePageViewModel
@using System.Globalization
@{
    var isWeekly = string.Equals(Model.ViewMode, "week", StringComparison.OrdinalIgnoreCase);
    var baseDate = isWeekly ? Model.WeekStart.Date : Model.SelectedDate.Date;
    var culture = CultureInfo.GetCultureInfo("lt-LT");

    var prevDate = baseDate.AddDays(isWeekly ? -7 : -1);
    var nextDate = baseDate.AddDays(isWeekly ? 7 : 1);

    var previewParam = Model.IsPreviewMode ? new { preview = true } : null;
    var basePreview = Model.IsPreviewMode ? true : (bool?)null;
    var plannedStart = Model.PlannedPeriodStart != default(DateTime) ? Model.PlannedPeriodStart.ToString("yyyy-MM-dd") : null;
    var plannedWeeks = Model.PlannedWeeks > 0 ? Model.PlannedWeeks : 1;
    var prevUrl = Url.Action("Index", "Schedule", new { view = Model.ViewMode, date = prevDate.ToString("yyyy-MM-dd"), preview = basePreview, plannedStart = plannedStart, plannedWeeks = plannedWeeks }) ?? "#";
    var nextUrl = Url.Action("Index", "Schedule", new { view = Model.ViewMode, date = nextDate.ToString("yyyy-MM-dd"), preview = basePreview, plannedStart = plannedStart, plannedWeeks = plannedWeeks }) ?? "#";
}

<div class="d-flex align-items-center mb-2 justify-content-between">
    <a class="btn btn-secondary btn-sm btn-rounded" href="@prevUrl" aria-label="Ankstesnis @(isWeekly ? "savaite" : "diena")"> < Ankstesnis</a>
    <a class="btn btn-secondary btn-sm" href="@nextUrl" aria-label="Kitas @(isWeekly ? "savaite" : "diena")">Kitas ></a>
</div>
