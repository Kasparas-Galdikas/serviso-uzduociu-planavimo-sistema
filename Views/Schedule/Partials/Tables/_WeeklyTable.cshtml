@model ServiceTaskPlanningSystem.Models.Planning.SchedulePageViewModel
@using ServiceTaskPlanningSystem.Models.Planning

@{
    var layout = Model.WeeklyLayout;
    if (layout == null)
    {
        <div class="alert alert-warning">Grafiko duomenys neprieinami.</div>
        return;
    }

    var tableModel = layout.Table;
    var headerLabel = layout.HeaderLabel;
}

<div class="card p-3 mb-4">
    <div class="d-flex align-items-center mb-3">
        <div class="fw-semibold">@headerLabel</div>
        <h5 class="mb-0 flex-grow-1 text-center">Savaites grafikas</h5>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-info text-dark">Mock duomenys</span>
        </div>
    </div>
    @{
        ViewData["CompactLegend"] = true;
        ViewData["StickyTable"] = true;
    }
    <div class="mb-2">
    </div>
    <div class="mt-2">
        @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_ViewNavigation.cshtml", Model)
    </div>

    @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_TableShell.cshtml", tableModel)

    <div class="">
        @await Html.PartialAsync("~/Views/Schedule/Partials/Tables/_ViewNavigation.cshtml", Model)
    </div>

</div>
