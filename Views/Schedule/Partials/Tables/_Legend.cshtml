@{
    var compactLegend = (ViewData["CompactLegend"] as bool?) ?? false;
}

<div class="legend">
    @if (!compactLegend)
    {
        <div class="legend-item"><span class="legend-dot bg-base"></span> Teigiama zona (normali uzduotis)</div>
        <div class="legend-item"><span class="legend-dot bg-load"></span> Apkrova (ne kritine)</div>
        <div class="legend-item"><span class="legend-dot bg-conflict"></span> Perkrova (kritine)</div>
    }
    else
    {
        <div class="legend-item"><span class="legend-dot bg-base" title="Normali" aria-label="Normali"></span></div>
        <div class="legend-item"><span class="legend-dot bg-load" title="Apkrova" aria-label="Apkrova"></span></div>
        <div class="legend-item"><span class="legend-dot bg-conflict" title="Perkrova" aria-label="Perkrova"></span></div>
    }
</div>
